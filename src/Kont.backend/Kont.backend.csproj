<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\Document\**" />
    <Compile Remove="Models\Search\**" />
    <Compile Remove="Tools\S3\**" />
    <Compile Remove="Tools\Searchers\**" />
    <Content Remove="Models\Document\**" />
    <Content Remove="Models\Search\**" />
    <Content Remove="Tools\S3\**" />
    <Content Remove="Tools\Searchers\**" />
    <EmbeddedResource Remove="Models\Document\**" />
    <EmbeddedResource Remove="Models\Search\**" />
    <EmbeddedResource Remove="Tools\S3\**" />
    <EmbeddedResource Remove="Tools\Searchers\**" />
    <None Remove="Models\Document\**" />
    <None Remove="Models\Search\**" />
    <None Remove="Tools\S3\**" />
    <None Remove="Tools\Searchers\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
